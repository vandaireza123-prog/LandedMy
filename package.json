{
  "name": "landedmy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed:sql": "node scripts/gen-seed-sql.mjs",
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@netlify/functions": "^6.0.3",
    "@supabase/supabase-js": "^2.118.0"
  }
}
